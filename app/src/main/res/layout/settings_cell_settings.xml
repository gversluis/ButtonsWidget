<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingTop="32dp"
        android:paddingEnd="40dp"
        android:paddingBottom="24dp">

        <RadioGroup
            android:id="@+id/radioGroupType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:checkedButton="@id/rbCallUrl">

            <RadioButton
                android:id="@+id/rbCallUrl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="0dp"
                android:text="Call URL (default)" />

            <RadioButton
                android:id="@+id/rbTextarea"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="0dp"
                android:text="Textarea (shows URL response)" />

            <RadioButton
                android:id="@+id/rbCopy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="0dp"
                android:text="Copy textarea content to clipboard" />

        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|center"
            android:orientation="horizontal">
            <Button
                android:id="@+id/browseIconBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Browse for Icon" />

            <ImageView
                android:id="@+id/selectedIconPreview"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginLeft="8dp"
                android:scaleType="fitCenter"
                android:contentDescription="Selected button icon"
                android:visibility="visible" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/unicodeRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button style="@style/UnicodeButton" android:text="🔴" />
                <Button style="@style/UnicodeButton" android:text="💡" />
                <Button style="@style/UnicodeButton" android:text="📋" />
                <Button style="@style/UnicodeButton" android:text="⏪" />
                <Button style="@style/UnicodeButton" android:text="⏹️" />
                <Button style="@style/UnicodeButton" android:text="▶️" />
                <Button style="@style/UnicodeButton" android:text="⏩" />
                <Button style="@style/UnicodeButton" android:text="🔊" />
                <Button style="@style/UnicodeButton" android:text="🔉" />
                <Button style="@style/UnicodeButton" android:text="🔇" />
                <Button style="@style/UnicodeButton" android:text="☰" />
                <Button style="@style/UnicodeButton" android:text="▲" />
                <Button style="@style/UnicodeButton" android:text="▼" />
                <Button style="@style/UnicodeButton" android:text="◀" />
                <Button style="@style/UnicodeButton" android:text="▶" />
                <Button style="@style/UnicodeButton" android:text="⏎" />
                <Button style="@style/UnicodeButton" android:text="📺" />
                <Button style="@style/UnicodeButton" android:text="📽️" />
                <Button style="@style/UnicodeButton" android:text="♻️" />
                <Button style="@style/UnicodeButton" android:text="🎬" />

            </LinearLayout>
        </HorizontalScrollView>

        <EditText
            android:id="@+id/textInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Button Text" />

        <EditText
            android:id="@+id/urlInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Example: https://example.org/api"
            android:inputType="textUri" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/hSpanInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="H-Span"
                android:inputType="number" />

            <EditText
                android:id="@+id/vSpanInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="V-Span"
                android:inputType="number" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
